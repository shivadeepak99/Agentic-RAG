# Copy to .env and fill in GROQ_API_KEY

ENVIRONMENT=dev

# Groq API — get key at https://console.groq.com
GROQ_API_KEY=

# openai/gpt-oss-120b: 500 tok/s, 131k context, strict JSON schema structured outputs
GROQ_MODEL=openai/gpt-oss-120b

# Set USE_REAL_LLM=true to disable ALL mocks and use the live Groq API.
# Required for: pytest -m real_llm   and live UI usage.
USE_REAL_LLM=false

# Chroma
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=papers

# Retrieval defaults
RETRIEVAL_MODE=lightweight_hybrid
RETRIEVAL_USE_RERANKER=false

# Override embedding model (default: sentence-transformers/all-MiniLM-L6-v2)
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Docker / one-click bootstrap
BOOTSTRAP_INGEST=true
INGEST_QUERY=cat:cs.AI
INGEST_MAX_RESULTS=20
RESET_CHROMA=false

# App server
PORT=8000
